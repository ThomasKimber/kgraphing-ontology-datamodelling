    SELECT DISTINCT 
    
            ?entity 
            ?entity_qualified_name
            ?entity_name
            ?entity_label 
            ?entity_description 
            ?entity_is_leaf
            ?attribute 
            ?attribute_qualified_name
            ?attribute_name
            ?attribute_label 
            ?attribute_sequence 
            ?attribute_description 
            ?domain 
            ?domain_qualified_name
            ?domain_name
            ?domain_label 
            ?domain_description 
            ?optional
            ?isPK
            ?isFK 
            
    WHERE 
    
        { 

            ?entity a kgdm:Entity;
                kgnam:FullyQualifiedName ?entity_qualified_name;
                kgnam:Name ?entity_name.
            OPTIONAL {?entity rdfs:label ?entity_label.}
            OPTIONAL {?entity kgdm:Description ?entity_description.}
            OPTIONAL {?entity kgdm:isLeafEntity ?entity_is_leaf.}
            
            OPTIONAL { ?attribute a kgdm:Attribute;
                           kgnam:FullyQualifiedName ?attribute_qualified_name;
                           kgnam:Name ?attribute_name;
                           kgdm:attributeIsPartOfEntity ?entity.          
                        OPTIONAL { ?attribute rdfs:label ?attribute_label.}
                        OPTIONAL {?attribute kgdm:ElementSequence ?attribute_sequence.}
                        OPTIONAL {?attribute kgdm:Description ?attribute_description.}
                        OPTIONAL {?attribute kgdm:AttributeIsOptional ?optional.}
                    }

            OPTIONAL {?attribute kgdm:attributeisMemberOfDomain ?domain.
                      ?domain a kgdm:Domain;
                          kgnam:Name ?domain_name;
                          kgnam:FullyQualifiedName ?domain_qualified_name.
                      OPTIONAL {?domain rdfs:label ?domain_label.}
                      OPTIONAL {?domain kgdm:Description ?domain_description.}
                      }
            
            BIND (EXISTS {
                        ?attribute kgdm:attributeisMemberOfKey ?k.
                        ?k a kgdm:ForeignKey.
                        } AS ?isFK)
            BIND (EXISTS {
                        ?attribute kgdm:attributeisMemberOfKey ?k.
                        ?k a kgdm:PrimaryKey.
                    } AS ?isPK)

        }
