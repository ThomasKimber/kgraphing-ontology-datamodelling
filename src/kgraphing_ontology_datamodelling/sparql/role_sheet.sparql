PREFIX kgdm: <https://kgraph.foo/onto/datamodelling#>
PREFIX kgnam: <https://kgraph.foo/onto/kgnam#>

    SELECT DISTINCT
        
        ?role
        ?role_type
        ?role_cardinality
        ?role_optionality

    WHERE
        {
            ?role a ?role_type.
            VALUES ?role_type { kgdm:SubjectRole kgdm:ObjectRole }
            OPTIONAL {?role kgdm:RoleCardinality ?role_cardinality.}
            OPTIONAL {?role kgdm:RoleOptionality ?role_optionality.}
        }
