PREFIX kgdm: <https://kgraph.foo/onto/datamodelling#>
PREFIX kgnam: <https://kgraph.foo/onto/kgnam#>

    SELECT
        
        ?role_key
        ?role_key_name
        ?role_key_qualified_name
        ?role_key_description
        ?role_key_label
        ?role_key_type
        ?attribute 
        ?attribute_name 
        ?attribute_qualified_name 
        ?attribute_label
        ?attribute_description
        ?attribute_sequence
        ?domain
        ?domain_name
        ?domain_qualified_name
        ?domain_label
        ?domain_description

    WHERE

        {

                # @BATCH(role_key)
                VALUES ?role_key {
                    # @BATCH_VALUES(role_key)
                }
                # @END_BATCH(role_key)
                
                ?role_key kgnam:FullyQualifiedName ?role_key_qualified_name;
                          kgnam:Name ?role_key_name.
                OPTIONAL { ?role_key kgdm:KeyType ?role_key_type. }
                OPTIONAL { ?role_key rdfs:label ?role_key_label. }
                OPTIONAL { ?role_key kgdm:Description ?role_key_description. }
                OPTIONAL { ?attribute kgdm:attributeisMemberOfKey ?role_key. 
                           ?attribute a kgdm:Attribute.
                OPTIONAL { ?attribute kgnam:Name ?attribute_name. }
                OPTIONAL { ?attribute kgnam:FullyQualifiedName ?attribute_qualified_name. }
                OPTIONAL { ?attribute rdfs:label ?attribute_label. }
                OPTIONAL { ?attribute kgdm:Description ?attribute_description. }
                OPTIONAL {?attribute kgdm:ElementSequence ?attribute_sequence.}
                OPTIONAL {?attribute kgdm:attributeisMemberOfDomain ?domain.
                                ?domain a kgdm:Domain;
                                    kgnam:Name ?domain_name;
                                    kgnam:FullyQualifiedName ?domain_qualified_name.
                                OPTIONAL {?domain rdfs:label ?domain_label.}
                                OPTIONAL {?domain kgdm:Description ?domain_description.}
                                }
                     }
            }
