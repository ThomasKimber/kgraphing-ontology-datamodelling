PREFIX kgdm: <https://kgraph.foo/onto/datamodelling#>
CONSTRUCT { ?subjectEntity kgdm:isLeafEntity ?leaf_test }
WHERE
{
    ?subjectEntity a kgdm:Entity.
    BIND (NOT EXISTS {    

        ?subjectRole kgdm:subjectRoleIsPartOfRelationship ?relationship;
            kgdm:subjectRoleIsAssociatedWithEntity ?subjectEntity.
    
        ?objectRole kgdm:objectRoleIsPartOfRelationship ?relationship;
            kgdm:objectRoleIsAssociatedWithEntity ?objectEntity.

                } as ?leaf_test)
}