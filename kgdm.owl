  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
    <rdfs:subClassOf rdf:nodeID="Na91f9bc40a44475c9d03fc60aa1fbc2d"/>
