  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#ElementSequence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    <rdfs:domain rdf:resource="https://kgraph.foo/onto/datamodelling#Element"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#InputParameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Parameter"/>
    <owl:disjointWith rdf:resource="https://kgraph.foo/onto/datamodelling#OutputParameter"/>
    <rdfs:comment>An InputParameter is a function-scoped name to which values can be bound at execution-time for input into a function.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5611fe1914ac42ae9407b9054d442935">
    <owl:inverseOf rdf:resource="https://kgraph.foo/onto/kgnam#isScopedWithin"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb7f03ce8702441e1b9ea3515666b2182">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#RelationshipOptionality"/>
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
    <rdfs:comment>A model describes a collection of classes and their interacting relationships, along with any annotative information that further describes their context.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N324e282a5a0f4976a5ef4dfd3c707e45">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Relationship"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Attribute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Element"/>
    <rdfs:subClassOf rdf:nodeID="N6de16443a18d46fc9c2119934581cee1"/>
    <rdfs:comment>An attribute is a property or feature that can be ascribed to an EntityType</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3c7be9b19dab4e15a25b09a012d503bc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#hasElementList"/>
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#ElementList"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
    <rdfs:subClassOf rdf:nodeID="N0307b94c16e540418a01651955a20d96"/>
    <rdfs:subClassOf rdf:nodeID="N7e2870a17a1d4713907d3d5da25a8eb7"/>
    <rdfs:subClassOf rdf:nodeID="N3c7be9b19dab4e15a25b09a012d503bc"/>
    <rdfs:comment>An Entity describes a concept, class, or table. Entities of the same EntityType are defined with common characteristics for which the EntityType acts as a container.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#SubjectArea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
    <rdfs:comment>A SubjectArea describes a thematic category or topic of area of interest. Individual Classes might be tagged with one or more SubjectAreas depending on their association to different contexts.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nffb8a69f1c664ba0b0ccb3f1ca09915f">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isAssociatedWith"/>
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#ForeignKey"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://kgraph.foo/onto/datamodelling/v1.0.0"/>
    <rdfs:comment>A data-modelling metamodel describing entity composition and relationships as well as inter and cross-model mappings.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#objectRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Role"/>
    <rdfs:subClassOf rdf:nodeID="N7feb6b5dd4194a7f9c9c2a6b1b095a01"/>
    <owl:disjointWith rdf:resource="https://kgraph.foo/onto/datamodelling#subjectRole"/>
    <rdfs:comment>The objectRole defines the object of a relationship.</rdfs:comment>
    <rdfs:comment>The objectRole should be associated with a PrimaryKey found on the entity to which the objectRole is also associated.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Key">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
    <rdfs:subClassOf rdf:nodeID="N1fda991daa1648d097c3b2ffc8662641"/>
    <rdfs:subClassOf rdf:nodeID="Nd5ab4f4ab24140b0b37babd016b10970"/>
    <rdfs:subClassOf rdf:nodeID="N06effd4e747e46e6aa65e5e098adacac"/>
    <rdfs:comment>A Key is a formal interface by which an entity is either referenced, or references another entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7e2870a17a1d4713907d3d5da25a8eb7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isSubclassOf"/>
    <owl:allValuesFrom rdf:resource="https://kgraph.foo/onto/datamodelling#SubTypeCluster"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7d2bd5110d9e49f1a2adb6feb295eb31">
    <rdf:first rdf:resource="https://kgraph.foo/onto/datamodelling#Key"/>
    <rdf:rest rdf:nodeID="Nd54289f15f764ed1a168a4b2f1ad3b94"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Relationship">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Association"/>
    <rdfs:subClassOf rdf:nodeID="Nd8d7b26dbaa1499589ed3c76ab284c82"/>
    <rdfs:subClassOf rdf:nodeID="N2fd1eea913834551a31ae7e971770e5e"/>
    <rdfs:comment>A relationship describes a relation between two classes. A relationship will be directed from the source (or child) referencing entity to a target (or parent) referenced entity via their respective keys. These keys are used to establish how that relationship can be encoded in practice, or for relationships with less defined specificity, they will exist as nominal placeholders.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4770c04ad0d1482d8b415d887dbe1d3e">
    <rdf:first rdf:nodeID="N194e1d57137e420d9e8c73480f4a50f3"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N06effd4e747e46e6aa65e5e098adacac">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#hasElementList"/>
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#ElementList"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#RelationshipOptionality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    <rdfs:domain rdf:resource="https://kgraph.foo/onto/datamodelling#Relationship"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#hasElementList">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:range rdf:resource="https://kgraph.foo/onto/datamodelling#ElementList"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2fc586c8c1a545bb865bebab733eb7c8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isAssociatedWith"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Element"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#isSubclassOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <rdfs:comment>A subsumptive relation from a a hyponym (a more specific type) to a hypernym (more general type).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7feb6b5dd4194a7f9c9c2a6b1b095a01">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isAssociatedWith"/>
    <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#PrimaryKey"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Element">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
    <rdfs:subClassOf rdf:nodeID="N92c2a722ae68464c8b2ceb2b64cef8f3"/>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#subjectRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Role"/>
    <rdfs:subClassOf rdf:nodeID="Nffb8a69f1c664ba0b0ccb3f1ca09915f"/>
    <rdfs:comment>A subjectRole should be associated with a ForeignKey, which should be situated on the entity to which the subjectRole is also associated. The pointer to which the ForeignKey provides a reference should be referenced by the corresponding objectRole's key and entity associations.</rdfs:comment>
    <rdfs:comment>The subjectRole defines the subject of a relationship.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2fd1eea913834551a31ae7e971770e5e">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#hasComponent"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#subjectRole"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nba4f326348914957910b6ed6cc3ba76f">
    <rdf:first rdf:resource="https://kgraph.foo/onto/datamodelling#Domain"/>
    <rdf:rest rdf:nodeID="N28b9e01e90994730b45868aea409c152"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#RoleCardinality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    <rdfs:domain rdf:resource="https://kgraph.foo/onto/datamodelling#Role"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6de16443a18d46fc9c2119934581cee1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#DataStructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Entity"/>
    <rdfs:comment>A DataStructure acts as a blueprint and describes the structured collection of attributes used to define an object. In physical contexts, might be used to describe denormalised views containing information source from multiple entities, e.g. in the case of a file format, message or api response definition.</rdfs:comment>
    <rdfs:comment>A datastructure is separate from EntityType as it carries no implication of being a normalised object.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#AttributeMapping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Mapping"/>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#List">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/kgnam#NamedObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Mapping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Association"/>
    <rdfs:comment>A mapping is a directed link between entities across differenct models or taxonomies. Its meaning is dependent on the Mapping's type. For more physical mappings, a mapping may apply a transformation through the application of a bound FunctionDefninition's parameters.</rdfs:comment>
    <rdfs:comment>Mappings might be used to link between definitions at different levels (e.g. Logical to Physical for example) or across models at the same level (e.g. when identifying isomorphisms across models)</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#SubTypeCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Association"/>
    <rdfs:subClassOf rdf:nodeID="Nfd2f291de070476992d882996acb855b"/>
    <rdfs:subClassOf rdf:nodeID="Nbcd6ac1a2d6e48f7a6024ec144852459"/>
    <rdfs:comment>A SubTypeCluster is similar to but distinct from a Relationship in that it relates entities through a directed association where one class is identified as the super-class, and multiple subordinate classes play the roles of sub-class. A SubTypeCluster can only reference a single Entity, but many sub-classes can reference it.</rdfs:comment>
    <rdfs:comment>An association between two classes that are taxonomically related. The child class being a more specific subset of the more generalised parent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N28b9e01e90994730b45868aea409c152">
    <rdf:first rdf:resource="https://kgraph.foo/onto/datamodelling#Element"/>
    <rdf:rest rdf:nodeID="N8bc96cd1107348688fb82d0da3402bc0"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Binding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Association"/>
    <rdfs:subClassOf rdf:nodeID="N2fc586c8c1a545bb865bebab733eb7c8"/>
    <rdfs:subClassOf rdf:nodeID="Na395564072d642ac9c4a7d3a3e36d8cd"/>
    <rdfs:comment>A binding describes the specific application of a function's parameter to a defined Element (an attribute or parameter).</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#hasComponent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    <owl:inverseOf rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
    <rdfs:comment>A function defines the rules and logic required to map from a collection of zero or more input parameters to a collection of zero or more output parameter(s). It is a behavioral definition.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na91f9bc40a44475c9d03fc60aa1fbc2d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isAssociatedWith"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Na395564072d642ac9c4a7d3a3e36d8cd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://kgraph.foo/onto/datamodelling#isPartOf"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    <owl:onClass rdf:resource="https://kgraph.foo/onto/datamodelling#Mapping"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://kgraph.foo/onto/datamodelling#Namespace">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://kgraph.foo/onto/datamodelling#Definition"/>
    <rdfs:comment>A namespace is a named set of names that are guaranteed to each be unambiguously assigned to an individual object. i.e. Each name defined in a namespace has a singular, definitive meaning or mapping to an object.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://kgraph.foo/onto/datamodelling#"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N194e1d57137e420d9e8c73480f4a50f3">
